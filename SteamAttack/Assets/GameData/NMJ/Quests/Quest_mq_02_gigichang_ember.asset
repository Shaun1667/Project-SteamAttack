  questId: mq_02_gigichang_ember
  title: "\uAE30\uAE30\uCC3D\uC758 \uBD88\uC528"
  category: 0
  summary: "\uD3ED\uC8FC \uD6C4 \uBA48\uCD98 \uBB3C\uBD88 \uBC1C\uC804\uAE30\uC5D0\uC11C \uB3D9\uB825\uD575\uC744 \uC218\uAC70\uD574 \uAE30\uAE30\uCC3D \uAE30\uC220\uC790\uC5D0\uAC8C \uAC00\uC838\uAC04\uB2E4."
  questGiverId: npc_gigichang_gisulja
  startDialogue: "\u2026\uC190\uC774 \uC5BC\uC5B4\uC11C \uB9D0\uC774 \uB2A6\uC2B5\uB2C8\uB2E4. \uB3D9\uB825\uD575 \uB2E4\uC12F\uC774\uBA74 \uD654\uB85C\uB97C \uB2E4\uC2DC \uB3CC\uB9BD\uB2C8\uB2E4. \uC9D0\uB3C4 \uB354 \uC2E4\uC744 \uC218 \uC788\uAC8C \uBC30\uB0AD\uC744 \uC190\uBD10 \uB4DC\uB9AC\uC9C0\uC694."
  completeDialogue: "\uD654\uB85C\uAC00 \uB3CC\uC558\uC2B5\uB2C8\uB2E4. \uC774\uC81C \uD55C\uAE30 \uC18D\uC5D0\uC11C\uB3C4 \uC0AC\uD758\uC740 \uBC84\uD301\uB2C8\uB2E4."
