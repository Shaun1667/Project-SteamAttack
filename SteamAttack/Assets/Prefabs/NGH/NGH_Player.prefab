--- !u!114 &5130903279594837647
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1766717810704266006}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9a2dc877dc6b4c2449adcbc77137c211, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NMJ.EndingCredits
  credits:
  - role: "\uAE30\uD68D \xB7 UI \xB7 \uC138\uACC4\uAD00"
    names:
    - "\uB098\uBBFC\uC7AC"
  - role: "\uD50C\uB808\uC774\uC5B4 \xB7 \uC804\uD22C \xB7 \uC2DC\uAC04 \uC5ED\uD589"
    names:
    - "\uB0A8\uADC0\uD6C8"
  - role: "\uBCF4\uC2A4 \xB7 \uD604\uBB34"
    names:
    - "BHS (\uC774\uB984)"
  - role: "\uC8FC\uC778\uACF5 \uBAA8\uB378 \xB7 \uD654\uC2B9\uCD1D \xB7 \uBC1B\uC544\uCE58\uAE30 \xB7 \uC77C\uBC18 \uC801"
    names:
    - "YPH (\uC774\uB984)"
  epilogue:
  - kind: 2
    speaker: "\uBB3C\uACFC \uBD88\uC774 \uC81C\uC790\uB9AC\uB97C \uCC3E\uB2E4"
    text: "\uC218\uD654\uAE30\uC81C"
    hold: 2.4
  - kind: 1
    speaker: 
    text: "\uBB34\uC0AC\uAC00 \uD63C\uCC9C\uC758\uB97C \uB4F1\uC5D0\uC11C \uD480\uC5B4, \uD604\uBB34\uC758 \uC2E0\uD575\uC5D0 \uBB3C\uB9B0\uB2E4."
    hold: 0
  - kind: 1
    speaker: 
    text: "\uC99D\uAE30\uD1B5\uC758 \uC555\uB825 \uC804\uBD80\uAC00 \uD63C\uCC9C\uC758\uB97C \uAC70\uAFB8\uB85C \uB3CC\uB9AC\uACE0, \uD604\uBB34\uB294 \uC0BC\uD0A8 \uC2DC\uAC04\uACFC \uC5F4\uC744 \uD5C8\uBB3C\uCC98\uB7FC \uBC97\uB294\uB2E4."
    hold: 0
  - kind: 1
    speaker: 
    text: "\uC99D\uAE30\uD1B5\uC774 \uD130\uC9C0\uBA70 \uC5F4\uC774 \uB3C4\uC131\uC73C\uB85C \uB3CC\uC544\uC628\uB2E4. \uD604\uBB34\uB294 \uC5F0\uBABB \uC544\uB798\uB85C \uAC00\uB77C\uC549\uC544 \uC7A0\uB4E0\uB2E4."
    hold: 0
  - kind: 0
    speaker: "\uBC31\uC131"
    text: "\u2026\uBC29\uAE08 \uADC0\uC2E0\uBD88\uC774 \uAE5C\uBE61\uC600\uB098?"
    hold: 0
  - kind: 0
    speaker: "\uACE0\uC885"
    text: "\uAE30\uC5B5\uD558\uB294 \uC774\uB294 \uC6B0\uB9AC\uBFD0\uC774\uB85C\uAD6C\uB098. \uADF8\uB7EC\uBA74 \uB418\uC5C8\uB2E4."
    hold: 0
  - kind: 0
    speaker: "\uACE0\uC885"
    text: "\uBD88\uC740 \uB044\uC9C0 \uC54A\uB294\uB2E4. \uB2E4\uB9CC \uBB3C\uC744 \uAC70\uC2A4\uB974\uC9C0 \uC54A\uAC8C \uC4F0\uB9AC\uB77C."
    hold: 2.6
  coda: 1
  codaPlace: "\uD5A5\uC6D0\uC815"
  codaPause: 1.1
  logo: "\u7384\u6B66"
  subtitle: "\uC5ED\uB958\uC758 \uC5B4\uBA85"
  creditsTitle: "\uB9CC\uB4E0 \uC0AC\uB78C\uB4E4"
  notice: "\uC774 \uC791\uD488\uC740 \uC2E4\uC874 \uC778\uBB3C\xB7\uC0AC\uAC74\uACFC \uBB34\uAD00\uD55C \uCC3D\uC791\uC785\uB2C8\uB2E4"
  thanks: "\uAC10\uC0AC\uD569\uB2C8\uB2E4"
  banner: {fileID: 1061133108650661386}
  titleScene: NMJ_Title
  titleTransition: 2
  font: {fileID: 11400000, guid: c62bbc190efdf2b4dbaa9ade4e2c3654, type: 2}
  glyphFont: {fileID: 11400000, guid: 83ee9e331d1d1c441a83ee4683eef5b0, type: 2}
  fadeInTime: 2
  scrollSpeed: 70
  inputDelay: 1.5
  backColor: {r: 0.03, g: 0.03, b: 0.035, a: 1}
  textColor: {r: 0.96, g: 0.95, b: 0.92, a: 1}
  brassColor: {r: 0.94, g: 0.73, b: 0.16, a: 1}
  sealColor: {r: 0.82, g: 0.18, b: 0.1, a: 1}
  snowColor: {r: 0.83, g: 0.93, b: 0.95, a: 1}
