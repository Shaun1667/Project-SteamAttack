--- !u!114 &578998269660234919
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2732405859948401036}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0cd3cfcd73e9e2146a0530d762956140, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NMJ.NmjReadable
  paper: 1
  label: "\uBE44\uB9DD\uB85D"
  heading: "\uAE30\uAE30\uCC3D \uC815\uBE44\uACF5\uC758 \uBE44\uB9DD\uB85D \uD55C \uC7A5"
  body: "\uC7A5\uC778\uB4E4\uC774 \uC544\uC9C1 \uAE30\uAE30\uCC3D \uC9C0\uBD95\uC744 \uC62C\uB9AC\uB294 \uC911\uC778\uB370, \uC2DC\uD5D8\uD558\uB358 \uC99D\uAE30\uD1B5\uC774 \uBA3C\uC800 \uC4F0\uC774\uAC8C \uB418\uC5C8\uB2E4.\n\uADF8 \uBC24 \uC774\uD6C4 \uB3C4\uC131\uC758 \uBD88\uC740 \uBAA8\uB450 \uC5BC\uC5C8\uB2E4. \uD654\uC2B9\uC758 \uBD88\uC528\uB3C4, \uD654\uC57D\uB3C4 \uBD99\uC9C0 \uC54A\uB294\uB2E4.\n\uD558\uC5EC \uD654\uC2B9\uCD1D\uC758 \uC6A9\uB450 \uC790\uB9AC\uC5D0 \uC99D\uAE30 \uACA9\uBC1C\uD2C0\uC744 \uB367\uB300\uC5C8\uB2E4. \uC2EC\uC9C0 \uB300\uC2E0 \uC555\uB825\uC774 \uD0C4\uC744 \uBBFC\uB2E4.\n\uD55C \uBC1C \uC3E0 \uB54C\uB9C8\uB2E4 \uC555\uB825\uC774 \uBE60\uC838 \uB3CC\uC544\uC624\uC9C0 \uC54A\uC73C\uB2C8, \uCE7C\uB85C \uCC44\uC6B4 \uC228\uC744 \uC544\uAEF4 \uC3D8\uB77C."
  signature: 
  radius: 2.4
  player: {fileID: 0}
  font: {fileID: 11400000, guid: c62bbc190efdf2b4dbaa9ade4e2c3654, type: 2}
